<!--
    Packages the classes compiled by JDT (bin/, Java 17 compliance) into lib/remoteAnt.jar
    for use inside the IDE (self-hosting). The Maven/Tycho build creates the JAR itself, see build.properties.
 -->
<project name="Build Ant remote support JAR" default="build" basedir="..">

	<target name="build" description="Builds the JAR if needed" depends="lib/remoteAnt.jar"/>

	<target name="init">
		<property name="build.result.folder" value="${basedir}"/>
		<property name="classes.folder" value="${basedir}/bin"/>
	</target>

	<target name="checkUpToDate" depends="init">
		<uptodate property="jarUpToDate" targetfile="${build.result.folder}/lib/remoteAnt.jar">
			<srcfiles dir="${classes.folder}" includes="**/*"/>
		</uptodate>
	</target>

	<target name="lib/remoteAnt.jar" description="Creates the remoteAnt.jar" depends="init, checkUpToDate" unless="jarUpToDate">
		<mkdir dir="${build.result.folder}/lib"/>
		<jar destfile="${build.result.folder}/lib/remoteAnt.jar" basedir="${classes.folder}"/>
	</target>

	<target name="clean" description="Deletes previous build remnants" depends="init">
		<delete file="${build.result.folder}/lib/remoteAnt.jar"/>
	</target>
</project>
